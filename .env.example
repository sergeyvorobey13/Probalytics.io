# Copy to .env and fill in. Get credentials at https://app.probalytics.io

# ClickHouse SQL access (all backtests)
PROBALYTICS_CLICKHOUSE_HOST=
PROBALYTICS_CLICKHOUSE_USERNAME=
PROBALYTICS_CLICKHOUSE_PASSWORD=
PROBALYTICS_CLICKHOUSE_DATABASE=probalytics

# Market Graph API (market_graph/ only) — app.probalytics.io → API Keys
PROBALYTICS_API_KEY_ID=
PROBALYTICS_API_KEY_SECRET=
